<p style="margin:0 0 16px; font-size:17px; font-weight:600; color:#E8EAED;">
  <%= t(".greeting", recipient: @email) %>
</p>

<% if @resource.try(:unconfirmed_email?) %>
  <p style="margin:0; color:#E8EAED;">
    <%= t(".changing", email: @resource.unconfirmed_email) %>
  </p>
<% else %>
  <p style="margin:0; color:#E8EAED;">
    <%= t(".changed", email: @resource.email) %>
  </p>
<% end %>
