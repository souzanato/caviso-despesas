<p style="margin:0 0 16px; font-size:17px; font-weight:600; color:#E8EAED;">
  <%= t(".greeting", recipient: @resource.email) %>
</p>

<p style="margin:0 0 8px; color:#E8EAED;">
  <%= t(".instruction") %>
</p>

<p style="margin:0; color:#E8EAED;">
  <%= t(".action_instruction") %>
</p>

<%= render "devise/mailer/button",
           label: t(".action"),
           url: unlock_url(@resource, unlock_token: @token) %>
