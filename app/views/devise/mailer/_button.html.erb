<%# locals: (label:, url:) %>
<%#
  Botão de CTA "bulletproof" para e-mail: table + <td bgcolor> + <a>.
  É o padrão que funciona no Outlook (que ignora padding em <a>) e nos
  demais clientes. Estilos inline de propósito.
%>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
  <tr>
    <td align="center" bgcolor="#0FA968" style="border-radius:10px;">
      <a href="<%= url %>"
         style="display:inline-block; padding:14px 28px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:15px; font-weight:600; line-height:1.2; color:#06251A; text-decoration:none; border-radius:10px;">
        <%= label %>
      </a>
    </td>
  </tr>
</table>
