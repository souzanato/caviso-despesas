<%# locals: (category:) %>

<%= form_with model: category, class: "ds-form" do |f| %>
  <%= render "shared/error_messages", resource: category %>

  <div class="ds-field">
    <%= f.label :name, t("categories.form.name_label"), class: "ds-field__label" %>
    <%= f.text_field :name, class: "ds-field__input", autofocus: true, autocomplete: "off" %>
    <p class="ds-field__hint"><%= t("categories.form.name_hint") %></p>
  </div>

  <%= f.submit category.persisted? ? t("categories.form.submit_update") : t("categories.form.submit_create"),
               class: "ds-btn ds-btn--block ds-btn--primary" %>
<% end %>

<%# O cancelar fica FORA do <form>: dentro dele, um link para a listagem
    funcionaria, mas a área de toque ficaria colada no submit. %>
<p>
  <%= link_to t("categories.form.cancel"), categories_path, class: "ds-btn ds-btn--secondary" %>
</p>
